class Solution {
    void rearrange(ArrayList<Integer> arr) {

        ArrayList<Integer> pos = new ArrayList<>();
        ArrayList<Integer> neg = new ArrayList<>();

        for (int num : arr) {
            if (num >= 0)
                pos.add(num);
            else
                neg.add(num);
        }
        int p = 0, n = 0;
        for (int i = 0; i < arr.size(); i++) {

            if (i % 2 == 0) {  
                if (p < pos.size()) {
                    arr.set(i, pos.get(p++));
                } else {
                    arr.set(i, neg.get(n++));
                }
            } else {          
                if (n < neg.size()) {
                    arr.set(i, neg.get(n++));
                } else {
                    arr.set(i, pos.get(p++));
                }
            }
        }
    }
}
