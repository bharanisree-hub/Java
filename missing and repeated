class Solution {
    ArrayList<Integer> findTwoElement(int arr[]) {
        ArrayList<Integer> a=new ArrayList<>();
        int rep=0;
        int mis=0;
        for(int i=0;i<arr.length;i++){
            for(int j=i+1;j<arr.length;j++){
                if(arr[i]==arr[j]){
                    rep=arr[i];
                    break;
                }
            }
        }for(int i=1;i<arr.length;i++){
            boolean f=false;
            for(int j=0;j<arr.length;j++){
                if(arr[j]==i){
                    f=true;
                    break;
                }
            }
        if(!f){
            mis=i;
            break;
        }
    }
    a.add(rep);
    a.add(mis);
    return a;
    }
}
