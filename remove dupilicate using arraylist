class Solution {
    public ArrayList<Integer> findDuplicates(int[] arr)
    {
        ArrayList<Integer> a = new ArrayList<>();

        for(int i = 0; i < arr.length; i++)
        {
            for(int j = i + 1; j < arr.length; j++)
            {
                if(arr[i] == arr[j])
                {
                    if(!a.contains(arr[i]))
                    {
                        a.add(arr[i]);
                    }
                    break;
                }
            }
        }

        return a;
    }
}
